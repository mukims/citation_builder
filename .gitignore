# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
.env
.venv
env/
venv/

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Local data — large / generated files not to be tracked ────────────────────
# ChromaDB vector database (rebuilt locally by Agent 3)
physics_vectordb/

# BM25 index (rebuilt locally by Agent 3)
bm25_index.pkl

# Downloaded PDFs (sourced automatically or placed manually)
pulled_pdfs/*.pdf
archive_pulled_pdfs/*.pdf
# Raw source PDFs (user-provided)
raw/**/*.pdf

# Extracted figure images
images/

# Detectron2 weights
*.pth

# ── Keep directory structure in git ───────────────────────────────────────────
!pulled_pdfs/.gitkeep
!raw/.gitkeep
!drafts/.gitkeep

# ── Generated pipeline state (rebuilt by the agents; never commit) ────────────
# These are written at runtime and are regenerated from raw/ on the next run.
# extracted_citations.json also carries author emails lifted from front pages.
downloaded.json
failed_downloads.json
extracted_citations.json

# ── Scraped author metadata (contains personal data) ──────────────────────────
# All of the below hold author email addresses harvested from paper front pages.
# Regenerate locally; do not commit.
metadata_auth.json
metadata_auth.jsonl
extracted_metadata.jsonl

# GROBID TEI output — machine-generated, and its <email> elements carry the
# same harvested author addresses. Regenerate by re-running GROBID.
grobid_output/

# ── One-off archive/backup snapshots ──────────────────────────────────────────
# Superseded by the live files above; nothing in the codebase reads them.
archive_*.json
*_full_backup.json

# ── Local agent scaffolding / vendored deps ───────────────────────────────────
# Google ADK session state (citation_builder_agent/)
.adk/
# Vendored detectron2 checkout — install as a dependency instead of committing
detectron2/

# ── Evaluation output ─────────────────────────────────────────────────────────
# Written by evaluate_rag.py. Embeds verbatim draft prose in its user_input
# column alongside retrieved paper excerpts, so it should not be committed.
evaluation_results.csv

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
